# Copy to .env.agent and fill in real values (never commit .env.agent):
#   cp .env.agent.example .env.agent
#
# run-ticket.sh sources this file automatically from the repo root.
# Or add to ~/.bashrc for all shells:
#   source /path/to/tutor-timetable/.env.agent

# Required
export GH_TOKEN=
export LINEAR_API_KEY=

# Claude agent (default) — pick ONE auth method:
#
# Option A: Pro/Max subscription (recommended if you have one)
#   Run once on your machine:  claude setup-token
#   Copy the printed token here (valid ~1 year; bills against your subscription):
# export CLAUDE_CODE_OAUTH_TOKEN=
#
# Option B: API pay-as-you-go (Anthropic Console billing)
# export ANTHROPIC_API_KEY=
#
# If both are set, Claude Code uses the API key. Leave ANTHROPIC_API_KEY unset
# when using your Pro/Max subscription.

# Cursor agent instead of Claude:
# export CURSOR_API_KEY=
# export AGENT_CLI=cursor

# Optional
# export GH_ALLOWED_REPO_PATH=VojtechKubac/tutor-timetable.git

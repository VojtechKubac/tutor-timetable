FROM golang:1.22-bookworm

ARG USERNAME=agent
# The gh apt repo only keeps the latest release; bump when builds break.
ARG GH_VERSION=2.96.0
ARG GH_ALLOWED_REPO_PATH=VojtechKubac/tutor-timetable.git
ARG USER_UID=1000
ARG USER_GID=1000

ENV GOFLAGS="-mod=mod"
ENV GH_ALLOWED_REPO_PATH=${GH_ALLOWED_REPO_PATH}

RUN apt-get update \
    && apt-get install -y --no-install-recommends git bash ca-certificates curl \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
         | dd of=/usr/share/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
         > /etc/apt/sources.list.d/github-cli.list \
    && apt-get update && apt-get install -y --no-install-recommends "gh=${GH_VERSION}*" \
    && rm -rf /var/lib/apt/lists/*

RUN git config --system credential.useHttpPath true \
    && git config --system credential.helper \
    '!f() { \
      proto=""; host=""; path=""; \
      while IFS= read -r line; do \
        [ -z "$line" ] && break; \
        case "$line" in \
          protocol=*) proto="${line#protocol=}" ;; \
          host=*) host="${line#host=}" ;; \
          path=*) path="${line#path=}" ;; \
        esac; \
      done; \
      if [ "$proto" = "https" ] && [ "$host" = "github.com" ]; then \
        req_path="${path#/}"; \
        allowed_path="${GH_ALLOWED_REPO_PATH:-}"; \
        req_path_norm="${req_path%.git}"; \
        allowed_path_norm="${allowed_path%.git}"; \
        if [ -z "${GH_TOKEN:-}" ]; then \
          echo "GH_TOKEN is not set; GitHub HTTPS auth is disabled." >&2; \
          return 0; \
        fi; \
        if [ -n "$allowed_path" ] && [ "$req_path_norm" != "$allowed_path_norm" ]; then \
          echo "Refusing GH_TOKEN for github.com/$req_path (allowed: $allowed_path)." >&2; \
          return 0; \
        fi; \
        echo "username=x-access-token"; \
        echo "password=${GH_TOKEN}"; \
      fi; \
    }; f'

RUN npm install -g @anthropic-ai/claude-code \
    && curl -fsSL https://cursor.com/install | bash \
    && ln -sf /root/.local/bin/cursor-agent /usr/local/bin/cursor-agent \
    && chmod 755 /root /root/.local /root/.local/bin \
    && chmod -R a+rx /root/.local/share/cursor-agent

# Playwright: system libraries baked in; browsers are installed at runtime by
# the agent (`npx playwright install chromium`) into the shared /ms-playwright
# cache volume so they survive container rebuilds.
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
RUN mkdir -p /ms-playwright && chmod 777 /ms-playwright \
    && npx --yes playwright@1.52.0 install-deps chromium \
    && rm -rf /var/lib/apt/lists/*

RUN git config --system user.name "ticket-agent" \
    && git config --system user.email "ticket-agent@noreply" \
    && git config --system core.hooksPath /git-hooks

RUN mkdir -p /git-hooks \
    && printf '#!/bin/sh\nwhile read local_ref local_sha remote_ref remote_sha; do\n  case "$remote_ref" in\n    refs/heads/main|refs/heads/master)\n      echo "ERROR: pushing to main/master is blocked in ticket containers." >&2\n      exit 1\n      ;;\n  esac\ndone\nexit 0\n' > /git-hooks/pre-push \
    && chmod +x /git-hooks/pre-push

RUN groupadd --gid "${USER_GID}" "${USERNAME}" \
    && useradd --uid "${USER_UID}" --gid "${USER_GID}" --create-home --shell /bin/bash "${USERNAME}" \
    # npm cache volume mountpoint must pre-exist agent-owned
    && mkdir -p "/home/${USERNAME}/.npm" \
    && chown -R "${USER_UID}:${USER_GID}" "/home/${USERNAME}/.npm"

WORKDIR /workspace

COPY backend/go.mod /tmp/backend/go.mod
RUN cd /tmp/backend && go mod download 2>/dev/null || true

# The sandbox workspace and Go module cache are named volumes that inherit
# these directories' ownership on first use; they must be writable by the
# agent user (git clone, go build). Must run AFTER the go mod prefetch above.
RUN chown "${USER_UID}:${USER_GID}" /workspace \
    && mkdir -p /go/pkg/mod \
    && chown -R "${USER_UID}:${USER_GID}" /go/pkg

USER ${USERNAME}

CMD ["/bin/bash"]

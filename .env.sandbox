# Sandbox .env template — copied to /workspace/.env inside ticket containers
# by scripts/sandbox/init-workspace.sh. Dev-only values, safe to commit.
# NEVER put real secrets in this file.

# Backend (DATABASE_URL comes from the container environment — do not set it here)
JWT_SECRET=ticket-dev-jwt-not-for-production

# Seed teacher (created on first backend startup if no teachers exist)
SEED_EMAIL=teacher@example.com
SEED_PASSWORD=changeme
SEED_NAME="Music Teacher"

# URLs used by the in-container stack and Playwright E2E helpers
FRONTEND_URL=http://localhost:3001
PUBLIC_API_URL=http://localhost:8081
